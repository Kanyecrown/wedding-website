# Environment variables for local development and production.
# Replace the placeholders with your actual Supabase database connection details.

# 1. DATABASE_URL: Use Supabase's Connection Pooler (Transaction Mode, port 6543)
# Make sure to append '?pgbouncer=true' (or '?pgconnector=true' for Supavisor) at the end of this URL.
# Example: postgresql://postgres.[YOUR-PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# 2. DIRECT_URL: Use Supabase's Direct Connection (Session Mode, port 5432)
# Used by Prisma to perform migrations and schema pushes, which are not allowed over Transaction mode.
# Example: postgresql://postgres.[YOUR-PROJECT-REF]:[PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"
